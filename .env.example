# WhatsApp Gateway Microservice Configuration
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=

# REST API Security Guard (x-api-key header)
GATEWAY_API_KEY=
API_GATEWAY_KEY=

# Redis connection string for storing multi-tenant Baileys AuthState
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=wa:session:

# Downstream webhook endpoint for inbound messages
WEBHOOK_URL=http://127.0.0.1:8000/api/whatsapp/webhook
WEBHOOK_ENABLED=false

# HMAC secret used to sign inbound webhook dispatches (X-Gateway-Signature-256)
WEBHOOK_SECRET=your_hmac_secret_here

# Bearer Token for authenticated webhook receivers
WEBHOOK_TOKEN=
WEBHOOK_BEARER_TOKEN=

# Media Storage Retention & Automatic Disk Pruning
MEDIA_RETENTION_HOURS=48
MEDIA_CLEANUP_INTERVAL_HOURS=6

# App URL & AI Studio environment variables
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

