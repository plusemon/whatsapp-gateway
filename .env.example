# WhatsApp Gateway Microservice Configuration
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=

# REST API Security Guard (x-api-key header)
API_GATEWAY_KEY=

# Redis connection string for storing multi-tenant Baileys AuthState
REDIS_URL=redis://127.0.0.1:6379

# Laravel / Botla webhook endpoint for inbound messages
BOTLA_WEBHOOK_URL=http://127.0.0.1:8000/api/whatsapp/webhook
BOTLA_WEBHOOK_ENABLED=false

# HMAC secret used to sign inbound webhook dispatches (x-botla-signature)
WEBHOOK_SECRET=your_hmac_secret_here

# Bearer Token for authenticated Laravel webhook receivers
BOTLA_WEBHOOK_TOKEN=

# Media Storage Retention & Automatic Disk Pruning
MEDIA_RETENTION_HOURS=48
MEDIA_CLEANUP_INTERVAL_HOURS=6

# App URL & AI Studio environment variables
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
